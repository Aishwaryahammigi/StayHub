<% layout("/layouts/boilerplate") %> 

<!-- Categories Filters and Tax Switch -->
<div id="filters-container" class="mb-4">
  <div id="filters">
    <div class="filter active">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing Pools</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-wheat-awn"></i></div>
      <p>Farms</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </div>
    <div class="filter">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p>
    </div>
  </div>

  <!-- Tax Toggle Switch -->
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" style="cursor: pointer;">
      <label class="form-check-label" for="switchCheckDefault" style="color: #222222;">Display total after taxes</label>
    </div>
  </div>
</div>

<!-- Listings Cards Grouped by State (Horizontal Scroll Rows) -->
<% 
  const groupedListings = {};
  for (let listing of allListings) {
    const locParts = (listing.location || "").split(",");
    const state = locParts.length > 1 ? locParts[1].trim() : (listing.location || "Other");
    if (!groupedListings[state]) {
      groupedListings[state] = [];
    }
    groupedListings[state].push(listing);
  }
%>

<div class="mt-2">
  <% for (let state of Object.keys(groupedListings)) { %>
    <div class="horizontal-scroll-section">
      <h3 class="horizontal-scroll-header">Popular properties in <%= state %></h3>
      <div class="horizontal-scroll-row">
        <% for(let listing of groupedListings[state]) { %>
          <div class="col-scroll">
            <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="card listing-card">
                <!-- Card Image Container with Badges/Wishlist Overlays -->
                <div class="card-img-container">
                  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
                  
                  <!-- Wishlist Heart Overlay -->
                  <i class="fa-regular fa-heart wishlist-heart"></i>
                </div>
                
                <!-- Card Details -->
                <div class="card-body">
                  <div class="card-header-row">
                    <span class="card-title-text"><%= listing.title %></span>
                    <span class="card-rating-box">
                      <i class="fa-solid fa-star"></i>
                      <!-- Deterministic mock rating based on listing price -->
                      <span><%= (4.6 + (listing.price % 4) * 0.1).toFixed(2) %></span>
                    </span>
                  </div>
                  
                  <div class="card-subtitle-text"><%= listing.location %>, <%= listing.country %></div>
                  
                  <div class="card-price-row">
                    <span class="card-price-amount">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                    <span class="card-price-period"> night</span>
                    <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                  </div>
                </div>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script>
  // Handle Tax Switch functionality
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo) {
      if(info.style.display !== "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });

  // Category filters active switching
  const filters = document.querySelectorAll('.filter');
  filters.forEach(filter => {
    filter.addEventListener('click', () => {
      document.querySelector('.filter.active').classList.remove('active');
      filter.classList.add('active');
    });
  });
</script>