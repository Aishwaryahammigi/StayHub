<% layout("/layouts/boilerplate") %>
<div class="row mt-3 justify-content-center">
  <div class="col-lg-8 col-md-10 col-12">
    <br/>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required/>
        <div class="valid-feedback">Title looks good!</div>
      </div>
      
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" rows="4" required></textarea> 
        <div class="invalid-feedback">Please provide a short description.</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image</label>
        <input name="listing[image]" type="file" class="form-control" required/>
        <div class="invalid-feedback">Please upload an image for the listing.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4 col-12">
          <label for="price" class="form-label">Price (\u20B9)</label>
          <input name="listing[price]" type="number" placeholder="1200" class="form-control" required/>
          <div class="invalid-feedback">Please provide a valid price.</div>
        </div>

        <div class="mb-3 col-md-8 col-12">
          <label for="country" class="form-label">Country</label>
          <input name="listing[country]" placeholder="India" type="text" class="form-control" required/>
          <div class="invalid-feedback">Please provide a valid country.</div>
        </div>
      </div>
      
      <div class="mb-3 col-12 px-0">
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required/>
        <div class="invalid-feedback">Please provide a valid location.</div>
      </div>

      <button class="btn btn-dark add-btn mt-3 px-4">Add Listing</button>
    </form>
  </div>
</div>
