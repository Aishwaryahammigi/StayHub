<% layout("/layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">
  <div class="col-md-10 col-12">
    <h2 class="fw-bold mb-4">Your Bookings</h2>

    <% if (bookings.length === 0) { %>
      <div class="card text-center p-5 border-0 shadow-sm" style="border-radius: 24px; background-color: #F7F7F7;">
        <div class="card-body">
          <i class="fa-regular fa-calendar-check mb-3 text-muted" style="font-size: 3.5rem;"></i>
          <h4 class="fw-bold">No trips booked yet...</h4>
          <p class="text-muted mb-4">Time to dust off your bags and start planning your next getaway!</p>
          <a href="/listings" class="btn btn-dark px-4 py-2 add-btn">Start Exploring</a>
        </div>
      </div>
    <% } else { %>
      <div class="row">
        <% for(booking of bookings) { %>
          <div class="col-12 mb-4">
            <div class="card shadow-sm p-3 flex-column flex-md-row" style="border-radius: 20px; border: 1px solid #DDDDDD;">
              <!-- Listing image -->
              <div class="col-md-4 col-12 mb-3 mb-md-0 position-relative">
                <% if(booking.listing) { %>
                  <img src="<%= booking.listing.image.url %>" class="w-100 h-100 rounded-3" style="object-fit: cover; min-height: 200px; max-height: 240px;" alt="listing">
                <% } else { %>
                  <div class="w-100 h-100 rounded-3 bg-secondary d-flex align-items-center justify-content-center text-white" style="min-height: 200px;">
                    Deleted Property
                  </div>
                <% } %>
              </div>
              
              <!-- Booking details -->
              <div class="col-md-8 col-12 ps-md-4 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex flex-wrap justify-content-between align-items-start mb-2 gap-2">
                    <div>
                      <h4 class="fw-bold mb-1">
                        <% if(booking.listing) { %>
                          <%= booking.listing.title %>
                        <% } else { %>
                          Deleted Property
                        <% } %>
                      </h4>
                      <p class="text-muted mb-0" style="font-size: 0.9rem;">
                        <% if(booking.listing) { %>
                          <i class="fa-solid fa-location-dot me-2 text-muted"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                        <% } %>
                      </p>
                    </div>
                    <span class="badge bg-success py-2 px-3 fs-7" style="border-radius: 12px;"><i class="fa-solid fa-shield-check me-2"></i>Confirmed & Paid</span>
                  </div>

                  <hr class="my-2">

                  <div class="row g-2">
                    <div class="col-sm-6 col-12">
                      <span class="fw-bold d-block" style="font-size: 0.8rem; color: #717171;">TRIP DATES</span>
                      <span class="fw-bold" style="font-size: 0.95rem;">
                        <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> 
                        – 
                        <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </span>
                    </div>
                    <div class="col-sm-6 col-12">
                      <span class="fw-bold d-block" style="font-size: 0.8rem; color: #717171;">GUESTS</span>
                      <span class="fw-bold" style="font-size: 0.95rem;"><%= booking.guests %> <%= booking.guests > 1 ? 'guests' : 'guest' %></span>
                    </div>
                  </div>

                  <div class="row g-2 mt-2">
                    <div class="col-sm-6 col-12">
                      <span class="fw-bold d-block" style="font-size: 0.8rem; color: #717171;">RECEIPT ID</span>
                      <code class="text-dark fw-bold" style="font-size: 0.9rem;"><%= booking.paymentId %></code>
                    </div>
                    <div class="col-sm-6 col-12">
                      <span class="fw-bold d-block" style="font-size: 0.8rem; color: #717171;">TOTAL PAID</span>
                      <span class="fw-bold text-success fs-5">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                    </div>
                  </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
                  <% if(booking.listing) { %>
                    <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark px-4" style="border-radius: 8px;">View Details</a>
                    <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(booking.listing.title + ', ' + booking.listing.location) %>" target="_blank" class="btn btn-dark px-4" style="border-radius: 8px;">
                      <i class="fa-solid fa-map-location-dot me-2"></i>Get Directions
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
