<% layout("/layouts/boilerplate") %>

<!-- Include Razorpay Checkout SDK -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="row mt-4 justify-content-center">
  <!-- Back link and Title -->
  <div class="col-md-10 col-12 mb-3">
    <a href="/listings/<%= listing._id %>?checkin=<%= checkIn %>&checkout=<%= checkOut %>&guests=<%= guests %>" class="text-dark fw-bold text-decoration-none">
      <i class="fa-solid fa-chevron-left me-2"></i>Back to listing
    </a>
    <h2 class="mt-3 fw-bold">Confirm and pay</h2>
  </div>

  <div class="col-md-10 col-12">
    <div class="row">
      <!-- Left Column: Booking Details & Payment Button -->
      <div class="col-lg-7 col-md-12 pe-lg-5">
        <h4 class="fw-bold mb-4">Your trip</h4>
        
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-1">Dates</h6>
            <span class="text-muted"><%= new Date(checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %> – <%= new Date(checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h6 class="fw-bold mb-1">Guests</h6>
            <span class="text-muted"><%= guests %> <%= guests > 1 ? 'guests' : 'guest' %></span>
          </div>
        </div>

        <hr class="my-4">

        <h4 class="fw-bold mb-4">Payment Method</h4>
        
        <div class="p-4 rounded-4 bg-light border mb-4 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <span class="fs-2 text-primary me-3"><i class="fa-solid fa-wallet"></i></span>
            <div>
              <h6 class="fw-bold mb-0">Razorpay Secure Checkout</h6>
              <small class="text-muted">Cards, UPI, Netbanking, Wallets</small>
            </div>
          </div>
          <img src="https://razorpay.com/assets/razorpay-glyph.svg" alt="Razorpay logo" style="width: 32px; height: 32px;">
        </div>

        <!-- Booking Form -->
        <form action="/listings/<%= listing._id %>/book" method="POST" id="checkoutPaymentForm">
          <input type="hidden" name="checkIn" value="<%= checkIn %>">
          <input type="hidden" name="checkOut" value="<%= checkOut %>">
          <input type="hidden" name="guests" value="<%= guests %>">
          <input type="hidden" name="totalPrice" value="<%= totalPrice %>">
          <input type="hidden" name="paymentId" id="paymentIdInput">

          <p class="text-muted mb-4" style="font-size: 0.8rem; line-height: 1.5;">
            By selecting the button below, I agree to the Host's House Rules, StayHub's Rebooking and Refund Policy, and that StayHub will securely charge my payment method via Razorpay.
          </p>

          <button type="button" class="btn w-100 py-3 fw-bold fs-6 mt-2 d-flex align-items-center justify-content-center gap-2 text-white" id="payBtn" style="border-radius: 12px; background-color: #3395FF; border: none; transition: background-color 0.2s;">
            <i class="fa-solid fa-shield-halved"></i>
            Pay with Razorpay (&#8377; <%= totalPrice.toLocaleString("en-IN") %>)
          </button>
        </form>
      </div>

      <!-- Right Column: Booking Summary Card -->
      <div class="col-lg-5 col-md-12 mt-4 mt-lg-0">
        <div class="card p-4 sticky-lg-top" style="top: 7rem; border-radius: 24px; border: 1px solid #DDDDDD; z-index: 10;">
          <!-- Listing Preview Header -->
          <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
            <img src="<%= originalImageUrl %>" class="rounded-3 me-3" style="width: 120px; height: 90px; object-fit: cover;" alt="listing">
            <div>
              <h6 class="fw-bold mb-1 text-truncate" style="max-width: 220px;"><%= listing.title %></h6>
              <div class="card-subtitle-text mb-1" style="font-size: 0.8rem;"><%= listing.location %></div>
              <div class="card-rating-box">
                <i class="fa-solid fa-star"></i>
                <span class="fw-bold" style="font-size: 0.8rem;"><%= (4.6 + (listing.price % 4) * 0.1).toFixed(2) %></span>
                <span class="text-muted" style="font-size: 0.8rem;">( <%= listing.reviews.length %> reviews )</span>
              </div>
            </div>
          </div>

          <!-- Price Details Summary -->
          <h5 class="fw-bold mb-3">Price details</h5>
          
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">
              &#8377; <%= listing.price.toLocaleString("en-IN") %> x <%= nights %> <%= nights > 1 ? 'nights' : 'night' %>
              <% if (guests > 2) { %>
                <br><small class="text-muted" style="font-size: 0.75rem;">(+ &#8377;500/night per extra guest)</small>
              <% } %>
            </span>
            <span>&#8377; <%= basePrice.toLocaleString("en-IN") %></span>
          </div>
          
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">StayHub Service fee (5%)</span>
            <span>&#8377; <%= serviceFee.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">GST (18%)</span>
            <span>&#8377; <%= gst.toLocaleString("en-IN") %></span>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Total (INR)</span>
            <span>&#8377; <%= totalPrice.toLocaleString("en-IN") %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- RAZORPAY CHECKOUT MODAL SIMULATOR (FALLBACK) -->
<!-- ========================================== -->
<div id="razorpayMockOverlay" class="d-none">
  <div class="razorpay-mock-modal shadow-lg animate-pop">
    <!-- Modal Header -->
    <div class="razorpay-mock-header">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
          <div class="razorpay-logo-badge me-2">S</div>
          <div>
            <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">StayHub</h6>
            <small class="text-white-50" style="font-size: 0.7rem;">Trips Booking Reservation</small>
          </div>
        </div>
        <div class="text-end">
          <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">&#8377;<%= totalPrice.toLocaleString("en-IN") %></h6>
          <small class="text-white-50" style="font-size: 0.7rem;">TEST MODE</small>
        </div>
      </div>
      <div class="mt-3 d-flex justify-content-between align-items-center text-white-50" style="font-size: 0.75rem;">
        <span><%= currUser.email %></span>
        <span>+91 98765 43210</span>
      </div>
    </div>

    <!-- Modal Body -->
    <div class="razorpay-mock-body d-flex">
      <!-- Methods Tabs (Left) -->
      <div class="razorpay-mock-tabs">
        <button type="button" class="rzp-tab active" onclick="switchRzpTab('card')">
          <i class="fa-solid fa-credit-card me-2"></i>Card
        </button>
        <button type="button" class="rzp-tab" onclick="switchRzpTab('upi')">
          <i class="fa-solid fa-mobile-screen me-2"></i>UPI / QR
        </button>
        <button type="button" class="rzp-tab" onclick="switchRzpTab('net')">
          <i class="fa-solid fa-building-columns me-2"></i>Netbanking
        </button>
      </div>

      <!-- Methods Forms (Right) -->
      <div class="razorpay-mock-forms flex-grow-1 p-4 bg-white">
        <!-- Card Form -->
        <div id="rzp-form-card" class="rzp-form-pane">
          <h6 class="fw-bold mb-3" style="font-size: 0.85rem; color: #4A5568;">Enter Card Details</h6>
          <div class="mb-3 position-relative">
            <input type="text" id="rzpCardNumber" class="form-control shadow-none" placeholder="Card Number" style="padding-right: 45px;">
            <span class="position-absolute end-0 top-50 translate-middle-y me-3 fs-5" style="z-index: 10;">
              <i id="rzpCardBrandIcon" class="fa-solid fa-credit-card text-muted"></i>
            </span>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <input type="text" id="rzpCardExpiry" class="form-control shadow-none" placeholder="Expiry (MM/YY)">
            </div>
            <div class="col-6">
              <input type="password" id="rzpCardCvv" class="form-control shadow-none" placeholder="CVV" maxlength="4">
            </div>
          </div>
          <div class="mb-2">
            <input type="text" id="rzpCardName" class="form-control shadow-none text-uppercase" placeholder="Cardholder Name">
          </div>
        </div>

        <!-- UPI / QR Form -->
        <div id="rzp-form-upi" class="rzp-form-pane d-none text-center">
          <h6 class="fw-bold mb-3 text-start" style="font-size: 0.85rem; color: #4A5568;">Pay via UPI</h6>
          
          <div class="d-flex justify-content-around gap-2 mb-3">
            <button type="button" class="btn btn-outline-light border text-dark flex-grow-1 py-2 upi-app-btn" onclick="selectUpiApp('gpay')">
              <i class="fa-brands fa-google-pay fs-3 text-primary"></i>
            </button>
            <button type="button" class="btn btn-outline-light border text-dark flex-grow-1 py-2 upi-app-btn" onclick="selectUpiApp('phonepe')">
              <i class="fa-solid fa-mobile-screen-button fs-4 text-purple" style="color: #5f259f;"></i><span class="ms-1 fw-bold small">PhonePe</span>
            </button>
            <button type="button" class="btn btn-outline-light border text-dark flex-grow-1 py-2 upi-app-btn" onclick="selectUpiApp('paytm')">
              <i class="fa-solid fa-wallet fs-4 text-info"></i><span class="ms-1 fw-bold small">Paytm</span>
            </button>
          </div>
          
          <div class="text-muted small mb-2">— Or Enter Custom UPI ID —</div>
          <div class="mb-2">
            <input type="text" id="rzpUpiId" class="form-control shadow-none text-center" placeholder="username@upihandle">
          </div>
        </div>

        <!-- Netbanking Form -->
        <div id="rzp-form-net" class="rzp-form-pane d-none">
          <h6 class="fw-bold mb-3" style="font-size: 0.85rem; color: #4A5568;">Select Popular Bank</h6>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="button" class="bank-pill active" onclick="selectBank(this, 'State Bank of India')"><i class="fa-solid fa-building-columns me-1"></i>SBI</button>
            <button type="button" class="bank-pill" onclick="selectBank(this, 'HDFC Bank')"><i class="fa-solid fa-building-columns me-1"></i>HDFC</button>
            <button type="button" class="bank-pill" onclick="selectBank(this, 'ICICI Bank')"><i class="fa-solid fa-building-columns me-1"></i>ICICI</button>
            <button type="button" class="bank-pill" onclick="selectBank(this, 'Axis Bank')"><i class="fa-solid fa-building-columns me-1"></i>Axis</button>
          </div>
          <select id="rzpBankSelect" class="form-select shadow-none">
            <option value="" disabled>Other Banks</option>
            <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
            <option value="Yes Bank">Yes Bank</option>
            <option value="Punjab National Bank">Punjab National Bank</option>
            <option value="Bank of Baroda">Bank of Baroda</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="razorpay-mock-footer p-3 bg-light border-top d-flex align-items-center justify-content-between">
      <span class="text-muted" style="font-size: 0.75rem;"><i class="fa-solid fa-lock me-1"></i>Secured by Razorpay</span>
      <button type="button" class="btn btn-primary px-4 py-2 fw-bold" id="rzpPaySubmitBtn" style="font-size: 0.85rem; background-color: #3395FF; border: none; border-radius: 6px;">
        Pay &#8377;<%= totalPrice.toLocaleString("en-IN") %>
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MOCK 3D SECURE OTP PORTAL (BANK SIMULATION) -->
<!-- ========================================== -->
<div id="otpOverlay" class="d-none">
  <div class="otp-card shadow animate-pop p-4 text-center bg-white rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
      <h6 class="fw-bold mb-0 text-dark" id="otpBankTitle">Secure Payment Authentication</h6>
      <img src="https://razorpay.com/assets/razorpay-glyph.svg" alt="Razorpay" style="width: 20px;">
    </div>
    
    <div class="text-start mb-3 bg-light p-3 rounded-3" style="font-size: 0.85rem;">
      <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Merchant:</span>
        <strong class="text-dark">StayHub Bookings</strong>
      </div>
      <div class="d-flex justify-content-between">
        <span class="text-muted">Amount:</span>
        <strong class="text-dark">&#8377; <%= totalPrice.toLocaleString("en-IN") %></strong>
      </div>
    </div>

    <p class="text-muted text-start mb-3" style="font-size: 0.8rem; line-height: 1.4;">
      An OTP has been sent to your registered mobile number ending in **4321.
    </p>

    <div class="mb-3">
      <input type="text" id="otpInput" class="form-control form-control-lg text-center fw-bold shadow-none" placeholder="123456" maxlength="6" style="letter-spacing: 0.4rem; font-size: 1.4rem;">
      <div class="invalid-feedback text-start mt-1" id="otpError" style="font-size: 0.75rem;">Please enter a valid 6-digit OTP.</div>
      <small class="text-muted d-block mt-2">Enter any 6-digit code to authorize the test payment.</small>
    </div>

    <div class="d-grid gap-2">
      <button type="button" class="btn btn-success py-2 fw-bold" id="otpSubmitBtn">Submit OTP</button>
      <button type="button" class="btn btn-light py-2 text-muted fw-bold border" id="otpCancelBtn">Cancel Transaction</button>
    </div>

    <div class="mt-3">
      <small class="text-muted" style="font-size: 0.75rem;">Resend OTP in <span id="otpTimer">59</span>s</small>
    </div>
  </div>
</div>

<!-- Fullscreen Processing Screen -->
<div id="paymentLoadingOverlay" class="d-none">
  <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center">
    <div class="spinner-border text-primary mb-4" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 4px;"></div>
    <h3 class="fw-bold text-white mb-2">Processing Payment</h3>
    <p class="text-white-50 fs-6">Contacting payment provider securely. Please do not refresh this page...</p>
  </div>
</div>

<script>
  const payBtn = document.getElementById('payBtn');
  const payForm = document.getElementById('checkoutPaymentForm');
  const payIdInput = document.getElementById('paymentIdInput');
  const rzpMockOverlay = document.getElementById('razorpayMockOverlay');
  const otpOverlay = document.getElementById('otpOverlay');
  const otpInput = document.getElementById('otpInput');
  const otpSubmitBtn = document.getElementById('otpSubmitBtn');
  const otpCancelBtn = document.getElementById('otpCancelBtn');
  const otpError = document.getElementById('otpError');
  const otpBankTitle = document.getElementById('otpBankTitle');
  const otpTimerSpan = document.getElementById('otpTimer');
  const paymentLoadingOverlay = document.getElementById('paymentLoadingOverlay');

  const rzpKeyId = "<%= razorpayKeyId %>";
  const totalPrice = <%= totalPrice %>;
  const listingTitle = "<%= listing.title %>";
  const userEmail = "<%= currUser.email %>";
  const userName = "<%= currUser.username %>";

  let selectedBankName = "State Bank of India";
  let otpInterval;

  payBtn.addEventListener('click', () => {
    // If a valid Razorpay API Key ID is supplied in .env, launch the real Razorpay Web SDK!
    if (rzpKeyId && rzpKeyId.trim() !== '') {
      const options = {
        "key": rzpKeyId,
        "amount": totalPrice * 100, // in paise
        "currency": "INR",
        "name": "StayHub",
        "description": `Booking Reservation - ${listingTitle}`,
        "image": "https://razorpay.com/assets/razorpay-glyph.svg",
        "handler": function (response) {
          paymentLoadingOverlay.classList.remove('d-none');
          payIdInput.value = response.razorpay_payment_id;
          setTimeout(() => {
            payForm.submit();
          }, 1500);
        },
        "prefill": {
          "name": userName,
          "email": userEmail
        },
        "theme": {
          "color": "#3395FF"
        }
      };
      
      try {
        const rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        console.error("Failed to load real Razorpay Checkout SDK, falling back to simulator:", err.message);
        launchMockRazorpay();
      }
    } else {
      // Default: Launch our beautiful Razorpay simulator that works out-of-the-box!
      launchMockRazorpay();
    }
  });

  // Simulator Launch
  function launchMockRazorpay() {
    rzpMockOverlay.classList.remove('d-none');
  }

  // Switch Razorpay Tabs
  function switchRzpTab(tabName) {
    const tabs = document.querySelectorAll('.rzp-tab');
    const panes = document.querySelectorAll('.rzp-form-pane');
    
    tabs.forEach(t => t.classList.remove('active'));
    panes.forEach(p => p.classList.add('d-none'));

    // Highlight clicked tab
    const activeTab = Array.from(tabs).find(t => t.textContent.toLowerCase().includes(tabName));
    if (activeTab) activeTab.classList.add('active');

    // Show panel
    const activePane = document.getElementById(`rzp-form-${tabName}`);
    if (activePane) activePane.classList.remove('d-none');
  }

  // Interactive Card Form Listeners
  const cardInput = document.getElementById('rzpCardNumber');
  const cardBrandIcon = document.getElementById('rzpCardBrandIcon');
  
  cardInput.addEventListener('input', (e) => {
    let value = e.target.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
    let formattedValue = '';
    for (let i = 0; i < value.length; i++) {
      if (i > 0 && i % 4 === 0) formattedValue += ' ';
      formattedValue += value[i];
    }
    e.target.value = formattedValue.substring(0, 19); // Max 16 digits + 3 spaces
    
    // Detect brand
    if (value.startsWith('4')) {
      cardBrandIcon.className = 'fa-brands fa-cc-visa text-primary';
    } else if (value.startsWith('5')) {
      cardBrandIcon.className = 'fa-brands fa-cc-mastercard text-warning';
    } else if (value.startsWith('6')) {
      cardBrandIcon.className = 'fa-solid fa-credit-card text-success'; // RuPay green
    } else {
      cardBrandIcon.className = 'fa-solid fa-credit-card text-muted';
    }
  });

  // Expiry formatting
  const expInput = document.getElementById('rzpCardExpiry');
  expInput.addEventListener('input', (e) => {
    let value = e.target.value.replace(/[^0-9]/gi, '');
    if (value.length > 2) {
      e.target.value = value.substring(0, 2) + '/' + value.substring(2, 4);
    } else {
      e.target.value = value;
    }
  });

  // Prefill UPI from Apps
  function selectUpiApp(appName) {
    const upiInput = document.getElementById('rzpUpiId');
    const uName = userName.toLowerCase().replace(/\s+/g, '');
    
    if (appName === 'gpay') {
      upiInput.value = `${uName}@okaxis`;
    } else if (appName === 'phonepe') {
      upiInput.value = `${uName}@ybl`;
    } else if (appName === 'paytm') {
      upiInput.value = `${uName}@paytm`;
    }
  }

  // Netbanking Selection
  function selectBank(element, bankName) {
    const pills = document.querySelectorAll('.bank-pill');
    pills.forEach(p => p.classList.remove('active'));
    element.classList.add('active');
    selectedBankName = bankName;
    document.getElementById('rzpBankSelect').value = ""; // Clear other bank dropdown
  }

  document.getElementById('rzpBankSelect').addEventListener('change', (e) => {
    const pills = document.querySelectorAll('.bank-pill');
    pills.forEach(p => p.classList.remove('active'));
    selectedBankName = e.target.value;
  });

  // Submit Simulated Payment -> Launch OTP Modal
  document.getElementById('rzpPaySubmitBtn').addEventListener('click', () => {
    // Determine title of OTP screen
    otpBankTitle.textContent = `${selectedBankName} 3D Secure`;
    
    rzpMockOverlay.classList.add('d-none');
    otpOverlay.classList.remove('d-none');
    
    // Clear input & start timer
    otpInput.value = "";
    otpInput.classList.remove('is-invalid');
    otpError.style.display = 'none';
    
    let timer = 59;
    otpTimerSpan.textContent = timer;
    clearInterval(otpInterval);
    otpInterval = setInterval(() => {
      timer--;
      otpTimerSpan.textContent = timer;
      if (timer <= 0) clearInterval(otpInterval);
    }, 1000);
  });

  // Submit OTP
  otpSubmitBtn.addEventListener('click', () => {
    const otpVal = otpInput.value.trim();
    if (otpVal.length !== 6 || isNaN(otpVal)) {
      otpInput.classList.add('is-invalid');
      otpError.style.display = 'block';
      return;
    }

    otpOverlay.classList.add('d-none');
    paymentLoadingOverlay.classList.remove('d-none');

    // Generate a mock payment ID starting with "pay_"
    const mockPayId = 'pay_' + Math.random().toString(36).substr(2, 14).toUpperCase();
    payIdInput.value = mockPayId;

    // Submit form after a realistic 2 second spinner delay
    setTimeout(() => {
      payForm.submit();
    }, 2000);
  });

  // Cancel OTP
  otpCancelBtn.addEventListener('click', () => {
    clearInterval(otpInterval);
    otpOverlay.classList.add('d-none');
    alert("Transaction cancelled by user.");
  });
</script>

<style>
  /* Styling to emulate the native Razorpay modal precisely */
  #payBtn:hover {
    background-color: #1a7fe6 !important;
  }

  #razorpayMockOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
  }

  #otpOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .razorpay-mock-modal {
    width: 100%;
    max-width: 580px;
    background-color: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .otp-card {
    width: 100%;
    max-width: 400px;
    background-color: #ffffff;
    border-radius: 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .razorpay-mock-header {
    background-color: #111827; /* Dark charcoal */
    padding: 24px;
    border-bottom: 1px solid #374151;
  }

  .razorpay-logo-badge {
    background-color: #3395FF;
    color: white;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-weight: bold;
    font-size: 1.1rem;
  }

  .razorpay-mock-body {
    min-height: 250px;
    background-color: #ffffff;
  }

  .razorpay-mock-tabs {
