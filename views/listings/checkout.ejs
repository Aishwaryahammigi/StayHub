<% layout("/layouts/boilerplate") %>

<!-- Include Razorpay Checkout SDK -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="row mt-4 justify-content-center">
  <!-- Back link and Title -->
  <div class="col-md-10 col-12 mb-3">
    <a href="/listings/<%= listing._id %>?checkin=<%= checkIn %>&checkout=<%= checkOut %>&guests=<%= guests %>" class="text-dark fw-bold text-decoration-none">
      <i class="fa-solid fa-chevron-left me-2"></i>Back to listing
    </a>
    <h2 class="mt-3 fw-bold">Confirm and pay</h2>
  </div>

  <div class="col-md-10 col-12">
    <div class="row">
      <!-- Left Column: Booking Details & Payment Button -->
      <div class="col-lg-7 col-md-12 pe-lg-5">
        <h4 class="fw-bold mb-4">Your trip</h4>
        
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-1">Dates</h6>
            <span class="text-muted"><%= new Date(checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %> – <%= new Date(checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h6 class="fw-bold mb-1">Guests</h6>
            <span class="text-muted"><%= guests %> <%= guests > 1 ? 'guests' : 'guest' %></span>
          </div>
        </div>

        <hr class="my-4">

        <h4 class="fw-bold mb-4">Payment Method</h4>
        
        <div class="p-4 rounded-4 bg-light border mb-4 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <span class="fs-2 text-primary me-3"><i class="fa-solid fa-wallet"></i></span>
            <div>
              <h6 class="fw-bold mb-0">Razorpay Secure Checkout</h6>
              <small class="text-muted">Cards, UPI, Netbanking, Wallets</small>
            </div>
          </div>
          <img src="https://razorpay.com/assets/razorpay-glyph.svg" alt="Razorpay logo" style="width: 32px; height: 32px;">
        </div>

        <!-- Booking Form -->
        <form action="/listings/<%= listing._id %>/book" method="POST" id="checkoutPaymentForm">
          <input type="hidden" name="checkIn" value="<%= checkIn %>">
          <input type="hidden" name="checkOut" value="<%= checkOut %>">
          <input type="hidden" name="guests" value="<%= guests %>">
          <input type="hidden" name="totalPrice" value="<%= totalPrice %>">
          <input type="hidden" name="paymentId" id="paymentIdInput">

          <p class="text-muted mb-4" style="font-size: 0.8rem; line-height: 1.5;">
            By selecting the button below, I agree to the Host's House Rules, StayHub's Rebooking and Refund Policy, and that StayHub will securely charge my payment method via Razorpay.
          </p>

          <button type="button" class="btn w-100 py-3 fw-bold fs-6 mt-2 d-flex align-items-center justify-content-center gap-2 text-white" id="payBtn" style="border-radius: 12px; background-color: #3395FF; border: none; transition: background-color 0.2s;">
            <i class="fa-solid fa-shield-halved"></i>
            Pay with Razorpay (&#8377; <%= totalPrice.toLocaleString("en-IN") %>)
          </button>
        </form>
      </div>

      <!-- Right Column: Booking Summary Card -->
      <div class="col-lg-5 col-md-12 mt-4 mt-lg-0">
        <div class="card p-4 sticky-lg-top" style="top: 7rem; border-radius: 24px; border: 1px solid #DDDDDD; z-index: 10;">
          <!-- Listing Preview Header -->
          <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
            <img src="<%= originalImageUrl %>" class="rounded-3 me-3" style="width: 120px; height: 90px; object-fit: cover;" alt="listing">
            <div>
              <h6 class="fw-bold mb-1 text-truncate" style="max-width: 220px;"><%= listing.title %></h6>
              <div class="card-subtitle-text mb-1" style="font-size: 0.8rem;"><%= listing.location %></div>
              <div class="card-rating-box">
                <i class="fa-solid fa-star"></i>
                <span class="fw-bold" style="font-size: 0.8rem;"><%= (4.6 + (listing.price % 4) * 0.1).toFixed(2) %></span>
                <span class="text-muted" style="font-size: 0.8rem;">( <%= listing.reviews.length %> reviews )</span>
              </div>
            </div>
          </div>

          <!-- Price Details Summary -->
          <h5 class="fw-bold mb-3">Price details</h5>
          
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">&#8377; <%= listing.price.toLocaleString("en-IN") %> x <%= nights %> <%= nights > 1 ? 'nights' : 'night' %></span>
            <span>&#8377; <%= basePrice.toLocaleString("en-IN") %></span>
          </div>
          
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">StayHub Service fee (5%)</span>
            <span>&#8377; <%= serviceFee.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">GST (18%)</span>
            <span>&#8377; <%= gst.toLocaleString("en-IN") %></span>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Total (INR)</span>
            <span>&#8377; <%= totalPrice.toLocaleString("en-IN") %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- RAZORPAY CHECKOUT MODAL SIMULATOR (FALLBACK) -->
<!-- ========================================== -->
<div id="razorpayMockOverlay" class="d-none">
  <div class="razorpay-mock-modal shadow-lg animate-pop">
    <!-- Modal Header -->
    <div class="razorpay-mock-header">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
          <div class="razorpay-logo-badge me-2">S</div>
          <div>
            <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">StayHub</h6>
            <small class="text-white-50" style="font-size: 0.7rem;">Trips Booking Reservation</small>
          </div>
        </div>
        <div class="text-end">
          <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">&#8377;<%= totalPrice.toLocaleString("en-IN") %></h6>
          <small class="text-white-50" style="font-size: 0.7rem;">TEST MODE</small>
        </div>
      </div>
    </div>

    <!-- Modal Body -->
    <div class="razorpay-mock-body d-flex">
      <!-- Methods Tabs (Left) -->
      <div class="razorpay-mock-tabs">
        <button type="button" class="rzp-tab active" onclick="switchRzpTab('card')">
          <i class="fa-solid fa-credit-card me-2"></i>Card
        </button>
        <button type="button" class="rzp-tab" onclick="switchRzpTab('upi')">
          <i class="fa-solid fa-mobile-screen me-2"></i>UPI / QR
        </button>
        <button type="button" class="rzp-tab" onclick="switchRzpTab('net')">
          <i class="fa-solid fa-building-columns me-2"></i>Netbanking
        </button>
      </div>

      <!-- Methods Forms (Right) -->
      <div class="razorpay-mock-forms flex-grow-1 p-3">
        <!-- Card Form -->
        <div id="rzp-form-card" class="rzp-form-pane">
          <h6 class="fw-bold mb-3" style="font-size: 0.85rem; color: #555;">Pay with Cards (Visa, Mastercard, RuPay)</h6>
          <div class="mb-2">
            <input type="text" class="form-control form-control-sm shadow-none" placeholder="Card Number" value="4242 4242 4242 4242" disabled>
          </div>
          <div class="row g-2 mb-2">
            <div class="col-6">
              <input type="text" class="form-control form-control-sm shadow-none" placeholder="Expiry (MM/YY)" value="12/29" disabled>
            </div>
            <div class="col-6">
              <input type="password" class="form-control form-control-sm shadow-none" placeholder="CVV" value="123" disabled>
            </div>
          </div>
          <div class="mb-3">
            <input type="text" class="form-control form-control-sm shadow-none" placeholder="Cardholder Name" value="TEST USER" disabled>
          </div>
        </div>

        <!-- UPI / QR Form -->
        <div id="rzp-form-upi" class="rzp-form-pane d-none text-center">
          <h6 class="fw-bold mb-2" style="font-size: 0.85rem; color: #555;">Scan QR Code to Pay</h6>
          <i class="fa-solid fa-qrcode mb-2 text-dark" style="font-size: 4rem;"></i>
          <small class="d-block text-muted mb-2">or enter your UPI ID</small>
          <input type="text" class="form-control form-control-sm shadow-none text-center" placeholder="success@upihandle" value="success@upihandle" disabled>
        </div>

        <!-- Netbanking Form -->
        <div id="rzp-form-net" class="rzp-form-pane d-none">
          <h6 class="fw-bold mb-3" style="font-size: 0.85rem; color: #555;">Popular Banks</h6>
          <div class="d-flex flex-wrap gap-2">
            <div class="bank-pill active"><i class="fa-solid fa-building-columns me-1"></i>SBI</div>
            <div class="bank-pill"><i class="fa-solid fa-building-columns me-1"></i>HDFC</div>
            <div class="bank-pill"><i class="fa-solid fa-building-columns me-1"></i>ICICI</div>
            <div class="bank-pill"><i class="fa-solid fa-building-columns me-1"></i>Axis Bank</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="razorpay-mock-footer p-3 border-top d-flex align-items-center justify-content-between">
      <span class="text-muted" style="font-size: 0.75rem;"><i class="fa-solid fa-lock me-1"></i>Secured by Razorpay</span>
      <button type="button" class="btn btn-primary px-4 fw-bold" id="rzpPaySubmitBtn" style="font-size: 0.85rem; background-color: #3395FF; border: none;">
        Pay &#8377;<%= totalPrice.toLocaleString("en-IN") %>
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- RAZORPAY TEST PAYMENT AUTHORIZATION POPUP -->
<!-- ========================================== -->
<div id="razorpayAuthOverlay" class="d-none">
  <div class="razorpay-auth-card shadow animate-pop p-4 text-center bg-white rounded-4" style="width: 320px; z-index: 10001;">
    <img src="https://razorpay.com/assets/razorpay-glyph.svg" alt="Razorpay" class="mb-3" style="width: 40px;">
    <h5 class="fw-bold mb-2">Razorpay Auth Portal</h5>
    <p class="text-muted small mb-4">This is a simulated Razorpay sandbox payment environment. Choose payment status:</p>
    <div class="d-grid gap-2">
      <button type="button" class="btn btn-success py-2 fw-bold" onclick="completeSimulatedPayment(true)">Success</button>
      <button type="button" class="btn btn-danger py-2 fw-bold" onclick="completeSimulatedPayment(false)">Failure</button>
    </div>
  </div>
</div>

<!-- Fullscreen Processing Screen -->
<div id="paymentLoadingOverlay" class="d-none">
  <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center">
    <div class="spinner-border text-primary mb-4" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 4px;"></div>
    <h3 class="fw-bold text-white mb-2">Processing Payment</h3>
    <p class="text-white-50 fs-6">Contacting payment provider securely. Please do not refresh this page...</p>
  </div>
</div>

<script>
  const payBtn = document.getElementById('payBtn');
  const payForm = document.getElementById('checkoutPaymentForm');
  const payIdInput = document.getElementById('paymentIdInput');
  const rzpMockOverlay = document.getElementById('razorpayMockOverlay');
  const rzpAuthOverlay = document.getElementById('razorpayAuthOverlay');
  const paymentLoadingOverlay = document.getElementById('paymentLoadingOverlay');

  const rzpKeyId = "<%= razorpayKeyId %>";
  const totalPrice = <%= totalPrice %>;
  const listingTitle = "<%= listing.title %>";
  const userEmail = "<%= currUser.email %>";
  const userName = "<%= currUser.username %>";

  payBtn.addEventListener('click', () => {
    // If a valid Razorpay API Key ID is supplied in .env, launch the real Razorpay Web SDK!
    if (rzpKeyId && rzpKeyId.trim() !== '') {
      const options = {
        "key": rzpKeyId,
        "amount": totalPrice * 100, // in paise
        "currency": "INR",
        "name": "StayHub",
        "description": `Booking Reservation - ${listingTitle}`,
        "image": "https://razorpay.com/assets/razorpay-glyph.svg",
        "handler": function (response) {
          paymentLoadingOverlay.classList.remove('d-none');
          payIdInput.value = response.razorpay_payment_id;
          setTimeout(() => {
            payForm.submit();
          }, 1500);
        },
        "prefill": {
          "name": userName,
          "email": userEmail
        },
        "theme": {
          "color": "#3395FF"
        }
      };
      
      try {
        const rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        console.error("Failed to load real Razorpay Checkout SDK, falling back to simulator:", err.message);
        launchMockRazorpay();
      }
    } else {
      // Default: Launch our beautiful Razorpay simulator that works out-of-the-box!
      launchMockRazorpay();
    }
  });

  // Simulator Launch
  function launchMockRazorpay() {
    rzpMockOverlay.classList.remove('d-none');
  }

  // Switch Razorpay Tabs
  function switchRzpTab(tabName) {
    const tabs = document.querySelectorAll('.rzp-tab');
    const panes = document.querySelectorAll('.rzp-form-pane');
    
    tabs.forEach(t => t.classList.remove('active'));
    panes.forEach(p => p.classList.add('d-none'));

    // Highlight clicked tab
    const activeTab = Array.from(tabs).find(t => t.textContent.toLowerCase().includes(tabName));
    if (activeTab) activeTab.classList.add('active');

    // Show panel
    const activePane = document.getElementById(`rzp-form-${tabName}`);
    if (activePane) activePane.classList.remove('d-none');
  }

  // Submit Simulated Payment
  document.getElementById('rzpPaySubmitBtn').addEventListener('click', () => {
    // Open the authentic simulated payment success/failure authorization popup
    rzpMockOverlay.classList.add('d-none');
    rzpAuthOverlay.classList.remove('d-none');
  });

  // Handle Auth options (Success / Failure)
  function completeSimulatedPayment(success) {
    rzpAuthOverlay.classList.add('d-none');
    
    if (success) {
      // Show payment processing loader
      paymentLoadingOverlay.classList.remove('d-none');
      
      // Generate a mock payment ID starting with "pay_"
      const mockPayId = 'pay_' + Math.random().toString(36).substr(2, 14).toUpperCase();
      payIdInput.value = mockPayId;

      // Submit form after a realistic 2 second spinner delay
      setTimeout(() => {
        payForm.submit();
      }, 2000);
    } else {
      alert("Payment authentication failed. Please try again.");
    }
  }
</script>

<style>
  /* Styling to emulate the native Razorpay modal precisely */
  #payBtn:hover {
    background-color: #1a7fe6 !important;
  }

  #razorpayMockOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
  }

  #razorpayAuthOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .razorpay-mock-modal {
    width: 100%;
    max-width: 520px;
    background-color: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .razorpay-mock-header {
    background-color: #0b1a30;
    padding: 20px;
    border-bottom: 1px solid #1a2f4c;
  }

  .razorpay-logo-badge {
    background-color: #3395FF;
    color: #white;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-weight: bold;
    font-size: 1.1rem;
    color: white;
  }

  .razorpay-mock-body {
    min-height: 220px;
    background-color: #f8f9fa;
  }

  .razorpay-mock-tabs {
    width: 150px;
    border-right: 1px solid #ebebeb;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    padding-top: 10px;
  }

  .rzp-tab {
    background: none;
    border: none;
    text-align: left;
    padding: 12px 16px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #4a5568;
    display: flex;
    align-items: center;
    transition: background-color 0.15s, color 0.15s;
    outline: none;
  }

  .rzp-tab:hover {
    background-color: #f7fafc;
  }

  .rzp-tab.active {
    background-color: #ebf8ff;
    color: #2b6cb0;
    border-left: 3px solid #3395FF;
  }

  .bank-pill {
    border: 1px solid #cbd5e0;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    background-color: #ffffff;
    transition: background-color 0.15s, border-color 0.15s;
  }

  .bank-pill:hover, .bank-pill.active {
    background-color: #ebf8ff;
    border-color: #3182ce;
    color: #2b6cb0;
  }

  .animate-pop {
    animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes popIn {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (max-width: 575.98px) {
    .razorpay-mock-modal {
      margin: 10px;
      max-width: calc(100% - 20px);
    }
    .razorpay-mock-body {
      flex-direction: column;
    }
    .razorpay-mock-tabs {
      width: 100%;
      flex-direction: row;
      border-right: none;
      border-bottom: 1px solid #ebebeb;
      padding-top: 0;
    }
    .rzp-tab {
      flex: 1;
      justify-content: center;
      padding: 10px;
      border-left: none;
      border-bottom: 3px solid transparent;
    }
    .rzp-tab.active {
      border-left: none;
      border-bottom-color: #3395FF;
      background-color: #ffffff;
    }
  }
</style>
